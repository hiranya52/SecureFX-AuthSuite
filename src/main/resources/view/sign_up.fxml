<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="410.0" prefWidth="294.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignUpFormController">
   <children>
      <AnchorPane prefHeight="410.0" prefWidth="294.0" style="-fx-background-color: #362e4f;" styleClass="anchor-pane-2" stylesheets="@../styles/style.css">
         <children>
            <TextField fx:id="txtEmail" layoutX="44.0" layoutY="177.0" prefHeight="26.0" prefWidth="210.0" promptText="     Email Address" style="-fx-border-radius: 8;" />
            <PasswordField fx:id="txtPassword" layoutX="44.0" layoutY="217.0" prefWidth="210.0" promptText="     Password" style="-fx-border-radius: 8;" />
            <PasswordField fx:id="txtReEnterPassword" layoutX="44.0" layoutY="257.0" prefWidth="210.0" promptText="     Re-enter Password" style="-fx-border-radius: 8;" />
         </children>
      </AnchorPane>
      <Label layoutX="86.0" layoutY="32.0" text="Sign Up" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="28.0" />
         </font>
      </Label>
      <TextField fx:id="txtFirstName" layoutX="45.0" layoutY="97.0" prefHeight="26.0" prefWidth="210.0" promptText="     First Name" style="-fx-border-radius: 8;" />
      <PasswordField fx:id="txtLastName" layoutX="45.0" layoutY="137.0" prefWidth="210.0" promptText="     Last Name" style="-fx-border-radius: 8;" />
      <Button layoutX="44.0" layoutY="306.0" mnemonicParsing="false" onAction="#btnRegisterOnAction" prefHeight="30.0" prefWidth="210.0" style="-fx-background-color: White;" stylesheets="@../styles/style.css" text="Register" textFill="#20173b">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Label layoutX="59.0" layoutY="348.0" text="Already have an account?" textFill="WHITE" />
      <Label fx:id="txtLogIn" layoutX="204.0" layoutY="348.0" onMouseClicked="#LogInOnAction" text="Log In" textFill="#0c9eff" />
   </children>
</AnchorPane>
