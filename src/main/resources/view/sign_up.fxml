<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="410.0" prefWidth="294.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignUpFormController">
   <children>
      <AnchorPane prefHeight="410.0" prefWidth="294.0" style="-fx-background-color: #362e4f;" styleClass="anchor-pane-2" stylesheets="@../styles/style.css">
         <children>
            <TextField fx:id="txtEmail" layoutX="44.0" layoutY="160.0" onKeyPressed="#emailOnAction" prefHeight="26.0" prefWidth="210.0" promptText="     Email Address" style="-fx-border-radius: 8;" />
            <PasswordField fx:id="txtPassword" layoutX="43.0" layoutY="213.0" onKeyPressed="#passwordOnAction" prefWidth="210.0" promptText="     Password" style="-fx-border-radius: 8;" />
            <PasswordField fx:id="txtReEnterPassword" layoutX="42.0" layoutY="261.0" onKeyReleased="#reEnterPasswordOnAction" prefWidth="210.0" promptText="     Re-enter Password" style="-fx-border-radius: 8;" />
            <TextField fx:id="txtLastName" layoutX="44.0" layoutY="122.0" prefHeight="26.0" prefWidth="210.0" promptText="     Last Name" style="-fx-border-radius: 8;" />
            <Label fx:id="lblPasswordValid" layoutX="46.0" layoutY="241.0" textFill="#0c9eff" />
            <Label fx:id="lblReEnterPasswordValid" layoutX="43.0" layoutY="291.0" textFill="#0c9eff" />
            <Label fx:id="lblEmail" layoutX="46.0" layoutY="186.0" textFill="#0c9eff" />
         </children>
      </AnchorPane>
      <Label layoutX="86.0" layoutY="26.0" text="Sign Up" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="28.0" />
         </font>
      </Label>
      <TextField fx:id="txtFirstName" layoutX="44.0" layoutY="85.0" prefHeight="26.0" prefWidth="210.0" promptText="     First Name" style="-fx-border-radius: 8;" />
      <Button layoutX="44.0" layoutY="315.0" mnemonicParsing="false" onAction="#btnRegisterOnAction" prefHeight="30.0" prefWidth="210.0" style="-fx-background-color: White;" stylesheets="@../styles/style.css" text="Register" textFill="#20173b">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Label layoutX="59.0" layoutY="353.0" text="Already have an account?" textFill="WHITE" />
      <Label fx:id="txtLogIn" layoutX="204.0" layoutY="353.0" onMouseClicked="#LogInOnAction" text="Log In" textFill="#0c9eff" />
   </children>
</AnchorPane>
