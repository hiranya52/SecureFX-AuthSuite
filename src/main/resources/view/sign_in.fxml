      <Label layoutX="105.0" layoutY="32.0" text="Login" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="28.0" />
         </font>
      </Label>
      <Label layoutX="45.0" layoutY="108.0" text="Email" textFill="WHITE">
         <font>
