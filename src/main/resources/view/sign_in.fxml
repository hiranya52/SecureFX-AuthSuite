      </Label>
      <TextField fx:id="txtEmail" layoutX="45.0" layoutY="135.0" prefHeight="26.0" prefWidth="210.0" style="-fx-border-radius: 8;" />
      <Label layoutX="45.0" layoutY="186.0" text="Password" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <PasswordField fx:id="txtPassword" layoutX="45.0" layoutY="212.0" prefWidth="210.0" style="-fx-border-radius: 8;" />
